extends layout

block content
  h1 Your account
  p.subtitle
    | #{email}
    if isAdmin
      |  #[span.badge Admin]

  if saved
    p.notice(role="status") Saved. Apps take the new name at your next sign-in.
  if done
    p.notice(role="status")= done

  form(action="/account", method="POST")
    input(type="hidden", name="_csrf", value=csrfToken)
    label.field
      span Display name
      input(type="text", name="name", value=ownName, placeholder=defaultName, maxlength="100", autocomplete="name")
      small.hint Leave empty to use #[strong= defaultName] from the mail server.
    .actions
      button.primary(type="submit") Save

  if orgs.length
    .orgs
      span.label Organizations
      ul
        each m in orgs
          li
            | #{m.org.name}
            if m.role === "admin"
              |  #[span.badge Admin]

  .twofactor
    span.label Two-factor login
    if totp
      p
        | On. #{codesLeft} recovery code#{codesLeft === 1 ? "" : "s"} left.
      details
        summary New recovery codes or turn off
        form(action="/account/totp/codes", method="POST")
          input(type="hidden", name="_csrf", value=csrfToken)
          label.field
            span Current code (app or recovery code)
            input(type="text", name="code", required, inputmode="numeric", autocomplete="one-time-code", maxlength="20")
          .actions
            button.secondary(type="submit") New recovery codes
            button.secondary(type="submit", formaction="/account/totp/disable") Turn off two-factor login
    else
      p Off. With it, signing in asks for a code from your phone after the password, for all apps.
      a.button.secondary(href="/account/totp") Set up two-factor login

  if isAdmin
    .admin-links
      span.label Administration
      ul
        li
          a(href="/account/admin") Users and organizations
          span.hint Organizations, roles, two-factor resets
        each link in adminLinks
          li
            a(href=link.url)= link.title
            if link.description
              span.hint= link.description

  .actions.more
    a.button.secondary(href=passwordUrl) Change password
    form(action="/account/signout", method="POST")
      input(type="hidden", name="_csrf", value=csrfToken)
      button.secondary(type="submit") Sign out everywhere
    a.button.secondary(href=dashboardUrl) Back to the dashboard
