extends layout

block content
  h1 Sign in
  if clientName
    p.subtitle to continue to #[strong= clientName]

  if error
    p.alert(role="alert")= error

  form(action=action, method="POST")
    input(type="hidden", name="_csrf", value=csrfToken)
    input(type="hidden", name="challenge", value=challenge)
    input(type="hidden", name="client_name", value=clientName)

    label.field
      span Email
      input(type="email", name="email", value=hint, required, autocomplete="username", autocapitalize="none", spellcheck="false", autofocus=!hint)

    label.field
      span Password
      .password
        input#password(type="password", name="password", required, autocomplete="current-password", autofocus=!!hint)
        //- Shown by /js/password.js; without JavaScript the field works as before
        button.reveal(type="button", aria-controls="password", aria-label="Show password", aria-pressed="false", hidden)
          svg.icon-show(viewBox="0 0 24 24", aria-hidden="true", focusable="false")
            path(d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z")
            circle(cx="12", cy="12", r="3")
          svg.icon-hide(viewBox="0 0 24 24", aria-hidden="true", focusable="false")
            path(d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24")
            line(x1="1", y1="1", x2="23", y2="23")

    label.check
      input(type="checkbox", name="remember", value="1")
      span Keep me signed in

    .actions
      button.primary(type="submit", name="submit", value="Log in") Sign in
      button.secondary(type="submit", name="submit", value="Deny access", formnovalidate) Cancel

  script(src="/js/password.js", defer)
