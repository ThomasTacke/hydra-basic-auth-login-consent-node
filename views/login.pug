extends layout

block content
  h1 Sign in
  if clientName
    p.subtitle to continue to #[strong= clientName]

  if error
    p.alert(role="alert")= error

  form(action=action, method="POST")
    input(type="hidden", name="_csrf", value=csrfToken)
    input(type="hidden", name="challenge", value=challenge)
    input(type="hidden", name="client_name", value=clientName)

    label.field
      span Email
      input(type="email", name="email", value=hint, required, autocomplete="username", autocapitalize="none", spellcheck="false", autofocus=!hint)

    label.field
      span Password
      input(type="password", name="password", required, autocomplete="current-password", autofocus=!!hint)

    label.check
      input(type="checkbox", name="remember", value="1")
      span Keep me signed in

    .actions
      button.primary(type="submit", name="submit", value="Log in") Sign in
      button.secondary(type="submit", name="submit", value="Deny access", formnovalidate) Cancel
