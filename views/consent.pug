extends layout

block content
  h1 Allow access?
  p.subtitle
    strong= client.client_name || client.client_id
    |  wants to access your account #[strong= user].

  form(action=action, method="POST")
    input(type="hidden", name="challenge", value=challenge)
    input(type="hidden", name="_csrf", value=csrfToken)

    fieldset.scopes
      legend Permissions
      each scope in requested_scope
        label.check
          input(type="checkbox", name="grant_scope", value=scope, checked)
          span= scope

    label.check
      input(type="checkbox", name="remember", value="1")
      span Don't ask again for this app

    if client.policy_uri || client.tos_uri
      p.links
        if client.policy_uri
          a(href=client.policy_uri, target="_blank", rel="noopener") Privacy policy
        if client.tos_uri
          a(href=client.tos_uri, target="_blank", rel="noopener") Terms of service

    .actions
      button.primary(type="submit", name="submit", value="Allow access") Allow
      button.secondary(type="submit", name="submit", value="Deny access") Deny
